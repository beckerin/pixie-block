{
  "name": "pixie",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "genkeys": "turbo run genkeys --filter=pixie-block",
    "run-cluster": "turbo run run-cluster --filter=pixie-block",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.6",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.6"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
