{
  "name": "pixie-block",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "pixie-block",
  "targets": {
    "build": {
      "executor": "@nx-go/nx-go:build",
      "cache": true,
      "inputs": [
        "{projectRoot}/go.mod",
        "{projectRoot}/go.sum",
        "{projectRoot}/**/*.go",
        "{workspaceRoot}/go.work",
        "{workspaceRoot}/go.work.sum"
      ],
      "outputs": ["{projectRoot}/bin"],
      "options": {
        "main": "./cmd/node",
        "outputPath": "bin/pixie-node"
      }
    },
    "test": {
      "executor": "@nx-go/nx-go:test",
      "cache": true,
      "inputs": [
        "{projectRoot}/go.mod",
        "{projectRoot}/go.sum",
        "{projectRoot}/**/*.go",
        "{workspaceRoot}/go.work",
        "{workspaceRoot}/go.work.sum"
      ]
    },
    "genkeys": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "pixie-block",
        "command": "go run ./tools/genkeys.go"
      }
    },
    "run": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "continuous": true,
      "options": {
        "cwd": "pixie-block",
        "command": "./bin/pixie-node --data-dir ./data/node1 --api-addr :8080 --p2p-listen :9000 --node-id node-1"
      }
    },
    "run-node2": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "continuous": true,
      "options": {
        "cwd": "pixie-block",
        "command": "./bin/pixie-node --data-dir ./data/node2 --api-addr :8081 --p2p-listen :9001 --node-id node-2 --peer 127.0.0.1:9000"
      }
    },
    "run-cluster": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "continuous": true,
      "options": {
        "cwd": "pixie-block",
        "command": "./bin/pixie-node --data-dir ./data/node1 --api-addr :8080 --p2p-listen :9000 --node-id node-1 & sleep 2 && ./bin/pixie-node --data-dir ./data/node2 --api-addr :8081 --p2p-listen :9001 --node-id node-2 --peer 127.0.0.1:9000"
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "pixie-block",
        "command": "rm -rf bin data"
      }
    }
  }
}
