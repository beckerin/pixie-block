# Docker Compose + Traefik (auto-scaling de followers)
# Copie para .env e ajuste: cp .env.example .env

# Porta HTTP publicada no host (Traefik)
PIXIE_HTTP_PORT=80

# Host usado em docs/exemplos (Traefik encaminha qualquer Host via PathPrefix `/`)
PIXIE_PUBLIC_HOST=pixie.localhost

# Autoscaler (métricas Prometheus do Traefik)
MIN_REPLICAS=1
MAX_REPLICAS=5
SCALE_UP_RPS=50
SCALE_DOWN_RPS=10
EVAL_INTERVAL=15s
COOLDOWN=60s

# O arquivo .env na raiz com POSTGRES_* é legado — o nó Go usa bbolt, não Postgres.
